{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile and run active file",
      "type": "shell",
      "command": "${workspaceFolder}/cc.cmd",
      "args": [
        "-Wall",
        "-Wextra",
        "-g",
        "-std=c11",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe",
        "&&",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "detail": "Ctrl+Shift+B : gcc compile, then immediately run. No debugger involved."
    },
    {
      "label": "Build active file (debug, no run)",
      "type": "shell",
      "command": "${workspaceFolder}/_tools/toolchain/w64devkit/bin/gcc.exe",
      "args": [
        "-Wall",
        "-Wextra",
        "-g",
        "-std=c11",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "${workspaceFolder}/_tools/toolchain/w64devkit/bin;${env:PATH}" }
      },
      "problemMatcher": ["$gcc"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "detail": "compile only, with -g debug info (this is what F5 needs first)"
    },
    {
      "label": "Build active file (release)",
      "type": "shell",
      "command": "${workspaceFolder}/_tools/toolchain/w64devkit/bin/gcc.exe",
      "args": [
        "-Wall",
        "-Wextra",
        "-O2",
        "-std=c11",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "${workspaceFolder}/_tools/toolchain/w64devkit/bin;${env:PATH}" }
      },
      "problemMatcher": ["$gcc"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "detail": "gcc -O2 optimized build"
    },
    {
      "label": "Build POS (src/pos.c -> pos.exe)",
      "type": "shell",
      "command": "${workspaceFolder}/_tools/toolchain/w64devkit/bin/gcc.exe",
      "args": [
        "-Wall",
        "-Wextra",
        "-g",
        "-std=c11",
        "src/pos.c",
        "-o",
        "pos.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "${workspaceFolder}/_tools/toolchain/w64devkit/bin;${env:PATH}" }
      },
      "problemMatcher": ["$gcc"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "detail": "builds the real assignment program once src/pos.c exists"
    }
  ]
}
