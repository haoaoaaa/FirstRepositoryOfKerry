{
  "version": 4,
  "configurations": [
    {
      "name": "Win32-GCC-w64devkit",
      "compilerPath": "${workspaceFolder}/_tools/toolchain/w64devkit/bin/gcc.exe",
      "compilerArgs": ["-Wall", "-Wextra", "-std=c11"],
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-gcc-x64",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/_tools/toolchain/w64devkit/include",
        "${workspaceFolder}/_tools/toolchain/w64devkit/x86_64-w64-mingw32/include",
        "${workspaceFolder}/_tools/toolchain/w64devkit/lib/gcc/x86_64-w64-mingw32/14.1.0/include"
      ],
      "defines": ["_DEBUG", "UNICODE", "_UNICODE"]
    }
  ]
}
